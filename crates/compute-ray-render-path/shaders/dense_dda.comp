#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D output_image;

layout(std430, set = 0, binding = 2) readonly buffer SceneData {
    uint words[];
} scene;

layout(std430, set = 0, binding = 3) readonly buffer CameraData {
    vec4 eye;
    vec4 forward;
    vec4 right;
    vec4 upward;
    vec4 clip_projection;
    vec4 fog_range_and_edge_shading;
} camera;

layout(std430, set = 0, binding = 4) buffer SemanticRayData {
    uint words[];
} semantic_rays;

const uint SCENE_PREFIX_WORD_COUNT = 4;
const uint VOLUME_HEADER_WORD_COUNT = 8;
const float LARGE_DISTANCE = 3.402823466e+38;
const uint SEMANTIC_RAY_INPUT_WORD_COUNT = 8;
const uint SEMANTIC_RAY_OUTPUT_WORD_COUNT = 8;
const uint SEMANTIC_RAY_INPUT_START = 1;
const uint SEMANTIC_RAY_OUTPUT_START = 65;

struct Volume {
    vec3 origin;
    float voxel_size;
    uvec3 extent;
    uint voxel_word_offset;
};

struct Hit {
    bool found;
    float distance;
    uint volume_index;
    uint material_word;
    ivec3 coordinate;
    vec3 normal;
};

Volume volume_at(uint volume_index) {
    uint offset = SCENE_PREFIX_WORD_COUNT + volume_index * VOLUME_HEADER_WORD_COUNT;
    return Volume(
        vec3(
            uintBitsToFloat(scene.words[offset]),
            uintBitsToFloat(scene.words[offset + 1]),
            uintBitsToFloat(scene.words[offset + 2])
        ),
        uintBitsToFloat(scene.words[offset + 3]),
        uvec3(scene.words[offset + 4], scene.words[offset + 5], scene.words[offset + 6]),
        scene.words[offset + 7]
    );
}

bool half_open_contains(Volume volume, vec3 point) {
    vec3 maximum = volume.origin + vec3(volume.extent) * volume.voxel_size;
    return all(greaterThanEqual(point, volume.origin)) && all(lessThan(point, maximum));
}

bool intersect_volume(
    Volume volume,
    vec3 ray_origin,
    vec3 ray_direction,
    float ray_minimum,
    float ray_maximum,
    out float entry_distance,
    out float exit_distance,
    out vec3 entry_normal
) {
    vec3 minimum = volume.origin;
    vec3 maximum = volume.origin + vec3(volume.extent) * volume.voxel_size;
    entry_distance = -LARGE_DISTANCE;
    exit_distance = LARGE_DISTANCE;
    entry_normal = vec3(-1.0, 0.0, 0.0);
    for (uint axis = 0; axis < 3; ++axis) {
        float direction = ray_direction[axis];
        if (direction == 0.0) {
            if (ray_origin[axis] < minimum[axis] || ray_origin[axis] >= maximum[axis]) {
                return false;
            }
            continue;
        }
        float minimum_distance = (minimum[axis] - ray_origin[axis]) / direction;
        float maximum_distance = (maximum[axis] - ray_origin[axis]) / direction;
        float axis_entry;
        float axis_exit;
        vec3 normal = vec3(0.0);
        if (direction > 0.0) {
            axis_entry = minimum_distance;
            axis_exit = maximum_distance;
            normal[axis] = -1.0;
        } else {
            axis_entry = maximum_distance;
            axis_exit = minimum_distance;
            normal[axis] = 1.0;
        }
        if (axis_entry > entry_distance) {
            entry_distance = axis_entry;
            entry_normal = normal;
        }
        exit_distance = min(exit_distance, axis_exit);
    }
    if (exit_distance <= entry_distance || exit_distance < ray_minimum || entry_distance > ray_maximum) {
        return false;
    }
    entry_distance = max(entry_distance, ray_minimum);
    exit_distance = min(exit_distance, ray_maximum);
    return true;
}

ivec3 coordinate_at(Volume volume, vec3 point) {
    vec3 local = (point - volume.origin) / volume.voxel_size;
    // The entry point lies on a volume face, and single-precision rounding can place it just
    // outside; flooring would then yield a cell outside the volume and drop the ray entirely.
    return clamp(ivec3(floor(local)), ivec3(0), ivec3(volume.extent) - ivec3(1));
}

bool coordinate_in_volume(Volume volume, ivec3 coordinate) {
    return all(greaterThanEqual(coordinate, ivec3(0))) && all(lessThan(coordinate, ivec3(volume.extent)));
}

uint dense_index(Volume volume, ivec3 coordinate) {
    return (uint(coordinate.z) * volume.extent.y + uint(coordinate.y)) * volume.extent.x
        + uint(coordinate.x);
}

Hit trace_volume(
    uint volume_index,
    vec3 ray_origin,
    vec3 ray_direction,
    float ray_minimum,
    float ray_maximum
) {
    Hit miss = Hit(false, 0.0, volume_index, 0, ivec3(0), vec3(0.0));
    Volume volume = volume_at(volume_index);
    vec3 clipped_start = ray_origin + ray_direction * ray_minimum;
    bool started_inside_volume = half_open_contains(volume, clipped_start);
    float distance;
    float exit_distance;
    vec3 normal;
    if (!intersect_volume(
        volume,
        ray_origin,
        ray_direction,
        ray_minimum,
        ray_maximum,
        distance,
        exit_distance,
        normal
    )) {
        return miss;
    }
    bool sparse = (scene.words[1] & 0x80000000u) != 0;
    ivec3 coordinate = coordinate_at(volume, ray_origin + ray_direction * distance);
    // Every step advances a tied axis and no axis retreats, so a volume admits at most one step
    // per cell boundary. The cap turns any future violation into a miss instead of a device hang.
    uint remaining_steps = volume.extent.x + volume.extent.y + volume.extent.z + 3;
    while (coordinate_in_volume(volume, coordinate) && distance <= exit_distance) {
        if (remaining_steps == 0) {
            return miss;
        }
        --remaining_steps;
        uint voxel_base = scene.words[3] + volume.voxel_word_offset;
        uint material_word;
        int edge = 1;
        if (sparse) {
            uvec3 grid = (volume.extent + uvec3(7)) / 8;
            uvec3 cell = uvec3(coordinate) / 8;
            uint entry = scene.words[voxel_base + (cell.z * grid.y + cell.y) * grid.x + cell.x];
            material_word = entry;
            if ((entry & 0x80000000u) != 0) {
                uvec3 local = uvec3(coordinate) % 8;
                uint index = local.x + 8 * local.y + 64 * local.z;
                uint pool = scene.words[3] + scene.words[scene.words[3]];
                uint packed = scene.words[pool + (entry & 0x7fffffffu) * 256 + index / 2];
                material_word = (packed >> (16 * (index % 2))) & 0xffffu;
            } else if (entry == 0) {
                edge = 8;
            }
        } else {
            material_word = scene.words[voxel_base + dense_index(volume, coordinate)];
        }
        if (material_word != 0) {
            vec3 contact_normal = started_inside_volume && distance == ray_minimum
                ? vec3(0.0)
                : normal;
            if (!sparse) {
                return Hit(true, distance, volume_index, material_word, coordinate, contact_normal);
            }
            // Coarse skips can land on an internal voxel boundary in another axis.
            // Rechecking the voxel excludes corner-only contacts and preserves face ties.
            Volume voxel = Volume(volume.origin + vec3(coordinate) * volume.voxel_size,
                volume.voxel_size, uvec3(1), 0);
            float voxel_entry;
            float voxel_exit;
            vec3 voxel_normal;
            if (half_open_contains(voxel, clipped_start)) {
                return Hit(true, ray_minimum, volume_index, material_word, coordinate, vec3(0.0));
            }
            if (intersect_volume(voxel, ray_origin, ray_direction, ray_minimum, ray_maximum,
                voxel_entry, voxel_exit, voxel_normal) && voxel_exit > ray_minimum) {
                return Hit(true, voxel_entry, volume_index, material_word, coordinate, voxel_normal);
            }
        }

        vec3 crossing = vec3(LARGE_DISTANCE);
        for (uint axis = 0; axis < 3; ++axis) {
            if (ray_direction[axis] == 0.0) {
                continue;
            }
            float boundary_coordinate = ray_direction[axis] > 0.0
                ? float(min((coordinate[axis] / edge + 1) * edge, int(volume.extent[axis])))
                : float(coordinate[axis] / edge * edge);
            float boundary = volume.origin[axis] + boundary_coordinate * volume.voxel_size;
            crossing[axis] = (boundary - ray_origin[axis]) / ray_direction[axis];
        }
        float next_distance = min(crossing.x, min(crossing.y, crossing.z));
        if (next_distance > exit_distance || next_distance > ray_maximum) {
            return miss;
        }
        // A tolerance can merge distinct crossings and skip a cell occupied by the ray.
        bvec3 tied = equal(crossing, vec3(next_distance));
        uint normal_axis = tied.x ? 0 : (tied.y ? 1 : 2);
        normal = vec3(0.0);
        normal[normal_axis] = ray_direction[normal_axis] > 0.0 ? -1.0 : 1.0;
        ivec3 next_coordinate = edge == 1 ? coordinate : coordinate_at(volume, ray_origin + ray_direction * next_distance);
        for (uint axis = 0; axis < 3; ++axis) {
            if (tied[axis]) {
                next_coordinate[axis] = ray_direction[axis] > 0.0
                    ? min((coordinate[axis] / edge + 1) * edge, int(volume.extent[axis]))
                    : coordinate[axis] / edge * edge - 1;
            } else if (ray_direction[axis] > 0.0) {
                // A rounded coarse-skip point near an untied boundary can fall back into the
                // previous cell; retreating there lets two cells alternate forever.
                next_coordinate[axis] = max(next_coordinate[axis], coordinate[axis]);
            } else if (ray_direction[axis] < 0.0) {
                next_coordinate[axis] = min(next_coordinate[axis], coordinate[axis]);
            }
        }
        coordinate = next_coordinate;
        distance = next_distance;
        started_inside_volume = false;
    }
    return miss;
}

Hit trace_scene_linear(
    vec3 ray_origin,
    vec3 ray_direction,
    float ray_minimum,
    float ray_maximum
);

// PROTOTYPE (issue #138): front-to-back 2D DDA over the fixture's 16x16 volume grid with early
// exit. Hardcodes the fixture layout (64-unit cells, one layer, identity order x-major) and falls
// back to the linear scan whenever the scene does not match it.
const int PROTOTYPE_GRID = 16;
const float PROTOTYPE_CELL = 64.0;

bool prototype_grid_matches(uint volume_index, int cell_x, int cell_z) {
    Volume volume = volume_at(volume_index);
    return volume.origin == vec3(float(cell_x) * PROTOTYPE_CELL, 0.0, float(cell_z) * PROTOTYPE_CELL)
        && abs(float(volume.extent.x) * volume.voxel_size - PROTOTYPE_CELL) < 0.001;
}

Hit trace_scene(
    vec3 ray_origin,
    vec3 ray_direction,
    float ray_minimum,
    float ray_maximum
) {
    Hit miss = Hit(false, ray_maximum, 0, 0, ivec3(0), vec3(0.0));
#ifdef LINEAR
    return trace_scene_linear(ray_origin, ray_direction, ray_minimum, ray_maximum);
#endif
    if (scene.words[0] != uint(PROTOTYPE_GRID * PROTOTYPE_GRID)) {
        return trace_scene_linear(ray_origin, ray_direction, ray_minimum, ray_maximum);
    }
    Volume world = Volume(vec3(0.0), PROTOTYPE_CELL, uvec3(PROTOTYPE_GRID, 1, PROTOTYPE_GRID), 0);
    float entry;
    float exit;
    vec3 unused_normal;
    if (!intersect_volume(world, ray_origin, ray_direction, ray_minimum, ray_maximum, entry, exit,
        unused_normal)) {
        return miss;
    }
    vec2 start = (ray_origin.xz + ray_direction.xz * entry) / PROTOTYPE_CELL;
    ivec2 cell = clamp(ivec2(floor(start)), ivec2(0), ivec2(PROTOTYPE_GRID - 1));
    vec2 direction = ray_direction.xz;
    ivec2 step_sign = ivec2(sign(direction));
    vec2 boundary_distance = vec2(LARGE_DISTANCE);
    vec2 delta = vec2(LARGE_DISTANCE);
    for (int axis = 0; axis < 2; ++axis) {
        if (direction[axis] != 0.0) {
            float boundary = float(cell[axis] + (direction[axis] > 0.0 ? 1 : 0)) * PROTOTYPE_CELL;
            boundary_distance[axis] = (boundary - ray_origin.xz[axis]) / direction[axis];
            delta[axis] = PROTOTYPE_CELL / abs(direction[axis]);
        }
    }
    for (int visited = 0; visited < 2 * PROTOTYPE_GRID; ++visited) {
        uint volume_index = uint(cell.x * PROTOTYPE_GRID + cell.y);
        if (!prototype_grid_matches(volume_index, cell.x, cell.y)) {
#ifdef NO_FALLBACK
            return miss;
#endif
            return trace_scene_linear(ray_origin, ray_direction, ray_minimum, ray_maximum);
        }
        Hit candidate = trace_volume(volume_index, ray_origin, ray_direction, ray_minimum,
            ray_maximum);
        if (candidate.found) {
            return candidate;
        }
        int axis = boundary_distance.x < boundary_distance.y ? 0 : 1;
        if (boundary_distance[axis] > exit) {
            return miss;
        }
        cell[axis] += step_sign[axis];
        if (cell[axis] < 0 || cell[axis] >= PROTOTYPE_GRID) {
            return miss;
        }
        boundary_distance[axis] += delta[axis];
    }
    return miss;
}

Hit trace_scene_linear(
    vec3 ray_origin,
    vec3 ray_direction,
    float ray_minimum,
    float ray_maximum
) {
    Hit nearest = Hit(false, ray_maximum, 0, 0, ivec3(0), vec3(0.0));
    uint volume_count = scene.words[0];
    for (uint volume_index = 0; volume_index < volume_count; ++volume_index) {
        Hit candidate = trace_volume(
            volume_index,
            ray_origin,
            ray_direction,
            ray_minimum,
            ray_maximum
        );
        if (candidate.found && (!nearest.found || candidate.distance < nearest.distance)) {
            nearest = candidate;
        }
    }
    return nearest;
}

uint normal_code(vec3 normal) {
    if (normal.x < 0.0) {
        return 1;
    }
    if (normal.x > 0.0) {
        return 2;
    }
    if (normal.y < 0.0) {
        return 3;
    }
    if (normal.y > 0.0) {
        return 4;
    }
    if (normal.z < 0.0) {
        return 5;
    }
    if (normal.z > 0.0) {
        return 6;
    }
    return 0;
}

void observe_semantic_ray(uint probe_index) {
    uint input_offset = SEMANTIC_RAY_INPUT_START
        + probe_index * SEMANTIC_RAY_INPUT_WORD_COUNT;
    vec3 origin = vec3(
        uintBitsToFloat(semantic_rays.words[input_offset]),
        uintBitsToFloat(semantic_rays.words[input_offset + 1]),
        uintBitsToFloat(semantic_rays.words[input_offset + 2])
    );
    float minimum_distance = uintBitsToFloat(semantic_rays.words[input_offset + 3]);
    vec3 direction = vec3(
        uintBitsToFloat(semantic_rays.words[input_offset + 4]),
        uintBitsToFloat(semantic_rays.words[input_offset + 5]),
        uintBitsToFloat(semantic_rays.words[input_offset + 6])
    );
    float maximum_distance = uintBitsToFloat(semantic_rays.words[input_offset + 7]);
    Hit hit = trace_scene(origin, direction, minimum_distance, maximum_distance);
    uint output_offset = SEMANTIC_RAY_OUTPUT_START
        + probe_index * SEMANTIC_RAY_OUTPUT_WORD_COUNT;
    semantic_rays.words[output_offset] = hit.found ? 1 : 0;
    semantic_rays.words[output_offset + 1] = hit.volume_index;
    semantic_rays.words[output_offset + 2] = uint(hit.coordinate.x);
    semantic_rays.words[output_offset + 3] = uint(hit.coordinate.y);
    semantic_rays.words[output_offset + 4] = uint(hit.coordinate.z);
    semantic_rays.words[output_offset + 5] = hit.material_word;
    semantic_rays.words[output_offset + 6] = floatBitsToUint(hit.distance);
    semantic_rays.words[output_offset + 7] = normal_code(hit.normal);
}

// Matches PresentationStyle::DISTANCE_FOG_LINEAR_COLOR and the raster path's copy.
const vec3 DISTANCE_FOG_COLOR = vec3(0.42, 0.56, 0.74);

// Matches the raster path's copy so switching paths does not change a voxel's shade.
float voxel_edge_shade(vec3 voxel_coordinate, vec3 normal) {
    vec3 within = fract(voxel_coordinate);
    vec3 edge_distance = min(within, 1.0 - within);
    // The face lies on an integer plane along its normal, so only the two tangent axes count.
    edge_distance = mix(edge_distance, vec3(1.0), abs(normal));
    float nearest = min(edge_distance.x, min(edge_distance.y, edge_distance.z));
    return mix(0.7, 1.0, smoothstep(0.0, 0.1, nearest));
}

vec4 material_color(uint material_word) {
    uint offset = scene.words[2] + (material_word - 1) * 4;
    return vec4(
        uintBitsToFloat(scene.words[offset]),
        uintBitsToFloat(scene.words[offset + 1]),
        uintBitsToFloat(scene.words[offset + 2]),
        uintBitsToFloat(scene.words[offset + 3])
    );
}

void main() {
    uint probe_index = gl_GlobalInvocationID.x;
    if (gl_GlobalInvocationID.y == 0 && probe_index < semantic_rays.words[0]) {
        observe_semantic_ray(probe_index);
    }

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dimensions = imageSize(output_image);
    if (any(greaterThanEqual(pixel, dimensions))) {
        return;
    }

    vec2 pixel_center = vec2(pixel) + vec2(0.5);
    vec2 normalized = vec2(
        2.0 * pixel_center.x / float(dimensions.x) - 1.0,
        1.0 - 2.0 * pixel_center.y / float(dimensions.y)
    );
    float tangent = camera.clip_projection.z;
    float aspect_ratio = camera.clip_projection.w;
    vec3 direction = normalize(
        camera.forward.xyz
            + camera.right.xyz * normalized.x * tangent * aspect_ratio
            + camera.upward.xyz * normalized.y * tangent
    );
    float forward_cosine = dot(direction, camera.forward.xyz);
    float ray_minimum = camera.clip_projection.x / forward_cosine;
    float ray_maximum = camera.clip_projection.y / forward_cosine;
    if (camera.eye.w > 0.0) {
        ray_maximum = min(ray_maximum, camera.eye.w);
    }

    Hit nearest = trace_scene(camera.eye.xyz, direction, ray_minimum, ray_maximum);

    float fog_start = camera.fog_range_and_edge_shading.x;
    float fog_end = camera.fog_range_and_edge_shading.y;
    vec4 color = fog_end > 0.0
        ? vec4(DISTANCE_FOG_COLOR, 1.0)
        : vec4(0.015, 0.02, 0.03, 1.0);
    if (nearest.found) {
        vec4 base_color = material_color(nearest.material_word);
        vec3 light_direction = normalize(vec3(0.4, 0.7, 0.5));
        bool started_inside = all(equal(nearest.normal, vec3(0.0)));
        float diffuse = started_inside
            ? 0.35
            : 0.35 + 0.65 * max(dot(nearest.normal, light_direction), 0.0);
        vec3 shaded = base_color.rgb * diffuse;
        if (camera.fog_range_and_edge_shading.z > 0.0 && !started_inside) {
            Volume volume = volume_at(nearest.volume_index);
            vec3 contact = camera.eye.xyz + direction * nearest.distance;
            shaded *= voxel_edge_shade((contact - volume.origin) / volume.voxel_size, nearest.normal);
        }
        if (fog_end > 0.0) {
            shaded = mix(shaded, DISTANCE_FOG_COLOR, smoothstep(fog_start, fog_end, nearest.distance));
        }
        color = vec4(shaded, base_color.a);
    }
    imageStore(output_image, pixel, color);
}
